# ============================================================
# DATABASE CONNECTION  (Supabase / PostgreSQL)
# ------------------------------------------------------------
# Copy this file to ".env" and fill in the values from the
# Supabase dashboard of the INTEGRATED project:
#   Connect  ->  Connection string  ->  "Session pooler"
#
# Why the Session pooler?  The direct host (db.<ref>.supabase.co)
# is IPv6-only and won't resolve on most networks. The pooler is
# IPv4-friendly. Its host looks like aws-1-<region>.pooler.supabase.com
# and the user looks like  postgres.<project-ref>.
# ============================================================

PGHOST=aws-1-<REGION>.pooler.supabase.com
PGPORT=5432
PGDATABASE=postgres
PGUSER=postgres.<PROJECT_REF>
PGPASSWORD=<YOUR_DB_PASSWORD>
PGSSLMODE=require

# Schemas to expose in the UI (local + the integrated remote schema)
LOCAL_SCHEMA=public
REMOTE_SCHEMA=remote_logistics

# Express backend port (the React dev server proxies /api here)
SERVER_PORT=4000

# Front-door login for the app itself (NOT the database role)
APP_USER=admin
APP_PASSWORD=admin
